---
import { getLocale, useTranslations, navItems, getAlternateLocaleUrl, localeUrl } from '../../utils/i18n';
import BrainLogo from '../common/BrainLogo.astro';
import type { Locale } from '../../i18n/config';

interface Props {
  currentLocale: string | undefined;
  pathname: string;
}

const { currentLocale, pathname } = Astro.props;
const locale = getLocale(currentLocale);
const t = useTranslations(locale);
const otherLocale: Locale = locale === 'pt-br' ? 'en' : 'pt-br';
const switchUrl = getAlternateLocaleUrl(locale, pathname);
---

<header class="sticky top-0 z-50 navbar bg-brand-900/40 backdrop-blur-xl border-b border-brand-300/30">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white"
  >
    {t('nav.skip')}
  </a>

  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
    aria-label={t('nav.ariaLabel')}
  >
    <a href={localeUrl(locale)} class="flex items-center gap-2 font-semibold text-white">
      <span class="grid h-8 w-8 place-items-center overflow-hidden rounded-xl" aria-hidden="true">
        <BrainLogo size={32} class="h-8 w-8" />
      </span>
      <span class="text-lg">{t('site.title')}</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => {
          const href = localeUrl(locale, item.href);
          const isActive = pathname === href || pathname.startsWith(href);
          return (
            <li>
              <a
                href={href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'rounded px-3 py-2 text-sm transition hover:bg-white/10 hover:text-white',
                  isActive ? 'bg-white/15 font-medium text-white' : 'text-brand-100',
                ]}
              >
                {t(item.key)}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={switchUrl}
        class="rounded border border-brand-300/50 px-3 py-1.5 text-sm font-medium text-brand-100 transition hover:border-brand-200 hover:text-white"
        lang={otherLocale}
        hreflang={otherLocale}
        aria-label={t('lang.label')}
      >
        <span aria-hidden="true">🌐</span>
        <span class="ml-1">{t(`lang.${otherLocale}`)}</span>
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle rounded border border-brand-300/50 px-3 py-1.5 text-brand-100 transition hover:border-brand-200 hover:text-white"
        aria-label={t('theme.toggle')}
      >
        <span class="moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z" />
          </svg>
        </span>
        <span class="sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5 19 19M19 5l-1.5 1.5M6.5 17.5 5 19" />
          </svg>
        </span>
      </button>

      <!-- Menu mobile -->
      <details class="md:hidden">
        <summary class="cursor-pointer rounded border border-brand-300/50 px-3 py-1.5 text-brand-100" aria-label="Menu">
          <span aria-hidden="true">☰</span>
        </summary>
        <ul class="absolute right-4 mt-2 w-48 rounded border border-brand-300/30 bg-brand-800 p-2 shadow-lg">
          {
            navItems.map((item) => {
              const href = localeUrl(locale, item.href);
              const isActive = pathname === href || pathname.startsWith(href);
              return (
                <li>
                  <a
                    href={href}
                    aria-current={isActive ? 'page' : undefined}
                    class:list={[
                      'block rounded px-3 py-2 text-sm hover:bg-white/10',
                      isActive ? 'bg-white/15 font-medium text-white' : 'text-brand-100',
                    ]}
                  >
                    {t(item.key)}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  if (btn) {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('cogito-theme', next);
      } catch {
        /* localStorage indisponível */
      }
    });
  }
</script>
