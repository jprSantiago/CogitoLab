---
import { getLocale, useTranslations, navItems, getAlternateLocaleUrl, localeUrl } from '../../utils/i18n';
import type { Locale } from '../../i18n/config';

interface Props {
  currentLocale: string | undefined;
  pathname: string;
}

const { currentLocale, pathname } = Astro.props;
const locale = getLocale(currentLocale);
const t = useTranslations(locale);
const otherLocale: Locale = locale === 'pt-br' ? 'en' : 'pt-br';
const switchUrl = getAlternateLocaleUrl(locale, pathname);
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-cogito-100">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white"
  >
    {t('nav.skip')}
  </a>

  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3"
    aria-label={t('nav.ariaLabel')}
  >
    <a href={localeUrl(locale)} class="flex items-center gap-2 font-semibold text-cogito-800">
      <span class="grid h-8 w-8 place-items-center rounded bg-brand-600 text-white" aria-hidden="true">C</span>
      <span class="text-lg">{t('site.title')}</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        navItems.map((item) => (
          <li>
            <a
                  href={localeUrl(locale, item.href)}
              class="rounded px-3 py-2 text-sm text-cogito-600 transition hover:bg-cogito-50 hover:text-cogito-900"
            >
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={switchUrl}
        class="rounded border border-cogito-200 px-3 py-1.5 text-sm font-medium text-cogito-700 transition hover:border-brand-500 hover:text-brand-700"
        lang={otherLocale}
        hreflang={otherLocale}
        aria-label={t('lang.label')}
      >
        <span aria-hidden="true">🌐</span>
        <span class="ml-1">{t(`lang.${otherLocale}`)}</span>
      </a>

      <!-- Menu mobile -->
      <details class="md:hidden">
        <summary class="cursor-pointer rounded border border-cogito-200 px-3 py-1.5" aria-label="Menu">
          <span aria-hidden="true">☰</span>
        </summary>
        <ul class="absolute right-4 mt-2 w-48 rounded border border-cogito-100 bg-white p-2 shadow-lg">
          {
            navItems.map((item) => (
              <li>
                <a
              href={localeUrl(locale, item.href)}
                  class="block rounded px-3 py-2 text-sm text-cogito-600 hover:bg-cogito-50"
                >
                  {t(item.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </nav>
</header>
