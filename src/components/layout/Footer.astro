---
import { getLocale, useTranslations, localeUrl } from '../../utils/i18n';
import { SITE_CONFIG } from '../../config/site';

interface Props {
  currentLocale: string | undefined;
}

const { currentLocale } = Astro.props;
const locale = getLocale(currentLocale);
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-white/50 bg-white/60 backdrop-blur">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2 font-semibold text-cogito-800">
          <span class="logo-badge grid h-8 w-8 place-items-center rounded text-white" aria-hidden="true">C</span>
          <span class="text-lg">{t('site.title')}</span>
        </div>
        <p class="mt-3 text-sm text-cogito-500">{t('footer.description')}</p>
      </div>

      <nav aria-label={t('site.title')} class="text-sm">
        <ul class="flex flex-wrap gap-x-4 gap-y-2">
          <li><a href={localeUrl(locale)} class="text-cogito-600 hover:text-cruzeiro-700">{t('nav.home')}</a></li>
          <li><a href={localeUrl(locale, '/areas')} class="text-cogito-600 hover:text-cruzeiro-700">{t('nav.areas')}</a></li>
          <li><a href={localeUrl(locale, '/members')} class="text-cogito-600 hover:text-cruzeiro-700">{t('nav.members')}</a></li>
          <li><a href={localeUrl(locale, '/projects')} class="text-cogito-600 hover:text-cruzeiro-700">{t('nav.projects')}</a></li>
          <li><a href={localeUrl(locale, '/contact')} class="text-cogito-600 hover:text-cruzeiro-700">{t('nav.contact')}</a></li>
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-cogito-100 pt-6 text-xs text-cogito-400">
      © {year} {SITE_CONFIG.name}. {t('footer.rights')}
    </div>
  </div>
</footer>
