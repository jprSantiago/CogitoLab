---
/**
 * AreaIcon — ícones SVG próprios (traço) para as 6 áreas de pesquisa,
 * substituindo os emojis. Reutilizável; `name` mapeia para a área.
 *
 * `name` deve corresponder a AreaId em src/data/areas.ts.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<string, string> = {
  // IA para SE — chip com "faísca"
  'ai-se':
    '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 1.5v2M15 1.5v2M9 20.5v2M15 20.5v2M1.5 9h2M1.5 15h2M20.5 9h2M20.5 15h2M12 9l-1.5 3H13L11.5 15"/>',
  // Qualidade — medidor (gauge)
  quality:
    '<path d="M3.5 16a8 8 0 1 1 14 0"/><path d="M12 16l4-4"/><circle cx="12" cy="16" r="1.4" fill="currentColor" stroke="none"/>',
  // Testes — frasco com check
  testing:
    '<path d="M9 2.5h6M10 2.5v5L5.5 17a2 2 0 0 0 1.8 3h9.4a2 2 0 0 0 1.8-3L14 7.5v-5"/><path d="M8.5 13.5l2 2 3.5-4"/>',
  // Mobile/IoT — dispositivo + sinal
  'mobile-iot':
    '<rect x="7" y="2.5" width="10" height="17" rx="2.2"/><path d="M10.5 18.5h3"/><path d="M18 8.5a4 4 0 0 1 0 5M20.5 6a7.5 7.5 0 0 1 0 9.5"/>',
  // Colaborativo — duas pessoas
  collaborative:
    '<circle cx="8.5" cy="8" r="3"/><circle cx="16" cy="9" r="2.4"/><path d="M3.5 19c0-3 2.5-5 5-5s5 2 5 5M14.5 19c0-2.4 1.6-4 3.5-4s3.5 1.6 3.5 4"/>',
  // Inovação — lâmpada
  innovation:
    '<path d="M12 2.5a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1.1 2.1h4.8c.1-.9.5-1.6 1.1-2.1A6 6 0 0 0 12 2.5Z"/><path d="M9.5 19h5M10.5 21.5h3"/>',
};
const body = paths[name] ?? paths['ai-se'];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
