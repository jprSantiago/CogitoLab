---
/**
 * BrainLogo — logotipo do Cogito Lab: cérebro VISTO DE LADO (perfil) formado por
 * uma rede de nós conectados (linhas de conexão), com pequenas linhas de código
 * correndo SOBRE as linhas que conectam os nós. Estilo "cérebro digital".
 *
 * Decorativo (aria-hidden), sem JavaScript. Usado na navbar e nas páginas.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 48, class: className = '' } = Astro.props;

const uid = 'brainside-' + Math.random().toString(36).slice(2, 9);

// Silhueta de cérebro de lado (perfil) com bulbo de tronco cerebral na base.
const brainPath = `M64 70
  C44 64 30 82 34 104
  C28 122 38 150 64 152
  C70 168 92 170 100 158
  L106 176 C106 184 120 184 120 176 L126 158
  C150 166 178 158 186 136
  C206 122 208 92 188 78
  C190 58 168 48 150 54
  C132 44 96 46 64 70 Z`;

// Grade de nós conectados (recortada no cérebro de lado).
const cols = 8;
const rows = 6;
const x0 = 40;
const y0 = 52;
const dx = 22;
const dy = 22;
const pts: { x: number; y: number }[] = [];
for (let gy = 0; gy < rows; gy++) {
  for (let gx = 0; gx < cols; gx++) {
    pts.push({ x: x0 + gx * dx, y: y0 + gy * dy });
  }
}
const at = (gx: number, gy: number) => gy * cols + gx;
const edges: [number, number][] = [];
for (let gy = 0; gy < rows; gy++) {
  for (let gx = 0; gx < cols; gx++) {
    if (gx + 1 < cols) edges.push([at(gx, gy), at(gx + 1, gy)]);
    if (gy + 1 < rows) edges.push([at(gx, gy), at(gx, gy + 1)]);
    if (gx + 1 < cols && gy + 1 < rows) edges.push([at(gx, gy), at(gx + 1, gy + 1)]);
  }
}

// Linhas de código que "correm" sobre as conexões (a cada 3 arestas).
const tokens = [
  'const', 'if', 'for', '=>', '{}', 'fn', '++', '</>', ';', '0x',
  'await', 'git', 'int', 'ret', 'let', 'new',
];
const labeled = edges
  .map(([a, b], i) => ({ a, b, i }))
  .filter(({ i }) => i % 3 === 0)
  .map(({ a, b }, k) => {
    const mx = (pts[a].x + pts[b].x) / 2;
    const my = (pts[a].y + pts[b].y) / 2;
    const ang = (Math.atan2(pts[b].y - pts[a].y, pts[b].x - pts[a].x) * 180) / Math.PI;
    return { mx, my, ang, text: tokens[k % tokens.length] };
  });
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 240 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0b2a63" />
      <stop offset="55%" stop-color="#003da5" />
      <stop offset="100%" stop-color="#001a44" />
    </linearGradient>
    <clipPath id={`${uid}-brain`}>
      <path d={brainPath} />
    </clipPath>
    <filter id={`${uid}-glow`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.8" result="b" />
      <feMerge>
        <feMergeNode in="b" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Corpo do cérebro (perfil) -->
  <path d={brainPath} fill={`url(#${uid}-bg)`} />

  <!-- Rede de conexões + código sobre as linhas, recortada no cérebro -->
  <g clip-path={`url(#${uid}-brain)`}>
    {
      edges.map(([a, b]) => (
        <line
          x1={pts[a].x}
          y1={pts[a].y}
          x2={pts[b].x}
          y2={pts[b].y}
          stroke="#7fe3ff"
          stroke-width="1"
          stroke-opacity="0.4"
        />
      ))
    }
    {
      labeled.map((l) => (
        <text
          x={l.mx}
          y={l.my}
          transform={`rotate(${l.ang} ${l.mx} ${l.my})`}
          text-anchor="middle"
          dominant-baseline="middle"
          font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
          font-size="5"
          fill="#dff1ff"
          fill-opacity="0.95"
        >
          {l.text}
        </text>
      ))
    }
    {
      pts.map((p) => (
        <circle cx={p.x} cy={p.y} r="2.1" fill="#bfe3ff" fill-opacity="0.95" />
      ))
    }
  </g>

  <!-- Contorno futurista com leve brilho -->
  <path
    d={brainPath}
    stroke="#7fe3ff"
    stroke-width="2.2"
    stroke-opacity="0.95"
    fill="none"
    filter={`url(#${uid}-glow)`}
  />
</svg>
