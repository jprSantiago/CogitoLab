---
/**
 * BrainLogo — nova identidade visual do Cogito Lab: uma LÂMPADA (luminária)
 * que contém, em seu interior, um CÉREBRO em 3D visto de LADO (perfil).
 *
 * O efeito "3D" vem de um gradiente claro→escuro (diagonal) no cérebro, de
 * uma luz de realce (highlight) e de dobras/giros em tom mais escuro.
 *
 * Decorativo (aria-hidden), sem JavaScript. Usado na navbar, splash e páginas.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 48, class: className = '' } = Astro.props;

const uid = 'bulbbrain-' + Math.random().toString(36).slice(2, 9);

// Silhueta de lâmpada (vidro) — base usada para preenchimento e recorte.
const bulbPath = `M120 18
  C 158 18 186 50 186 88
  C 186 114 170 130 154 138
  L 154 150 L 86 150 L 86 138
  C 70 130 54 114 54 88
  C 54 50 82 18 120 18 Z`;

// Cérebro de lado (perfil) reaproveitado, recortado dentro do vidro.
const brainPath = `M64 70
  C 44 64 30 82 34 104
  C 28 122 38 150 64 152
  C 70 168 92 170 100 158
  L 106 176 C 106 184 120 184 120 176 L 126 158
  C 150 166 178 158 186 136
  C 206 122 208 92 188 78
  C 190 58 168 48 150 54
  C 132 44 96 46 64 70 Z`;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 240 210"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${uid}-glass`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#bfe3ff" stop-opacity="0.30" />
      <stop offset="100%" stop-color="#003da5" stop-opacity="0.12" />
    </linearGradient>
    <linearGradient id={`${uid}-brain`} x1="0.15" y1="0" x2="0.85" y2="1">
      <stop offset="0%" stop-color="#f2f9ff" />
      <stop offset="48%" stop-color="#7fb4f0" />
      <stop offset="100%" stop-color="#103a86" />
    </linearGradient>
    <radialGradient id={`${uid}-glow`} cx="0.5" cy="0.38" r="0.65">
      <stop offset="0%" stop-color="#7fe3ff" stop-opacity="0.55" />
      <stop offset="100%" stop-color="#7fe3ff" stop-opacity="0" />
    </radialGradient>
    <filter id={`${uid}-soft`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2.2" result="b" />
      <feMerge>
        <feMergeNode in="b" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
    <clipPath id={`${uid}-bulb`}>
      <path d={bulbPath} />
    </clipPath>
  </defs>

  <!-- Brilho ao redor da lâmpada -->
  <ellipse cx="120" cy="96" rx="98" ry="98" fill={`url(#${uid}-glow)`} />

  <!-- Vidro da lâmpada -->
  <path d={bulbPath} fill={`url(#${uid}-glass)`} stroke="#cfe6ff" stroke-width="2.4" stroke-opacity="0.85" />

  <!-- Base / rosca da lâmpada -->
  <g fill="#9fb8d8" stroke="#6f8fc0" stroke-width="1.4" stroke-linejoin="round">
    <path d="M88 150 L152 150 L150 161 L90 161 Z" />
    <rect x="92" y="161" width="56" height="6" rx="2" />
    <rect x="94" y="169" width="52" height="6" rx="2" />
    <path d="M98 177 h44 a7 7 0 0 1 -7 11 h-30 a7 7 0 0 1 -7 -11 z" />
  </g>

  <!-- Cérebro 3D (de lado) dentro do vidro -->
  <g clip-path={`url(#${uid}-bulb)`}>
    <g transform="translate(40 14) scale(0.62)">
      <path d={brainPath} fill={`url(#${uid}-brain)`} />
      <!-- Giros / dobras (tom escuro, baixa opacidade) -->
      <path
        d="M70 80 C 92 70 122 78 152 70 M64 104 C 92 96 132 104 172 96 M80 132 C 110 122 150 132 180 122"
        stroke="#0b2a63"
        stroke-opacity="0.40"
        stroke-width="3"
        fill="none"
      />
      <path
        d="M100 60 C 96 90 110 120 100 150 M140 58 C 150 90 138 120 150 150"
        stroke="#0b2a63"
        stroke-opacity="0.30"
        stroke-width="2.5"
        fill="none"
      />
      <!-- Realce (highlight) para dar volume 3D -->
      <ellipse cx="82" cy="74" rx="42" ry="26" fill="#ffffff" opacity="0.28" />
    </g>
  </g>

  <!-- Reflexo do vidro -->
  <path
    d="M84 40 C 70 52 64 72 66 92"
    stroke="#ffffff"
    stroke-opacity="0.5"
    stroke-width="3"
    stroke-linecap="round"
    fill="none"
  />
</svg>
