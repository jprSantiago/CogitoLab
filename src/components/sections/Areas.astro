---
import { getLocale, useTranslations } from '../../utils/i18n';
import { pick } from '../../data/types';
import { areas } from '../../data/areas';
import { getProject } from '../../data/projects';
import { getPublication } from '../../data/publications';
import CodeBackdrop from '../common/CodeBackdrop.astro';
import MonitorCode from '../common/MonitorCode.astro';
import AreaIcon from '../common/AreaIcon.astro';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section id="areas" class="reveal relative mx-auto max-w-6xl scroll-mt-24 px-4 py-10">
  <CodeBackdrop class="pointer-events-none absolute inset-0 h-full w-full opacity-70" />
  <MonitorCode class="pointer-events-none absolute -right-4 top-4 hidden w-44 opacity-30 lg:block" />

  <div class="relative z-10">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-white">{t('areas.title')}</h1>
      <p class="mt-2 text-brand-100">{t('areas.subtitle')}</p>
    </header>

    <div class="carousel" data-carousel>
      <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label={t('carousel.prev')}>&#8249;</button>
      <ul class="carousel__track">
      {
        areas.map((area) => (
          <li class="carousel__slide card-3d" id={`area-${area.id}`}>
            <details class="group">
              <summary class="flex cursor-pointer items-center gap-4 list-none">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-brand-600 text-white" aria-hidden="true">
                  <AreaIcon name={area.id} class="h-6 w-6" />
                </span>
                <h2 class="text-lg font-semibold text-cogito-800">{pick(locale, area.title)}</h2>
              </summary>

              <div class="mt-4 border-t border-cogito-100 pt-4">
                <p class="text-sm text-cogito-600">{pick(locale, area.description)}</p>

                <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-cogito-400">
                  {t('areas.topics')}
                </h3>
                <ul class="mt-1 flex flex-wrap gap-1">
                  {area.topics.map((topic) => (
                    <li class="rounded-full bg-cogito-50 px-2 py-0.5 text-xs text-cogito-600">
                      {pick(locale, topic)}
                    </li>
                  ))}
                </ul>

                {area.projects.length > 0 && (
                  <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-cogito-400">
                    {t('common.relatedProjects')}
                  </h3>
                  <ul class="mt-1 space-y-1">
                    {area.projects.map((pid) => {
                      const p = getProject(pid);
                      return p ? (
                        <li>
                          <a href="#projects" class="text-sm text-brand-700 underline hover:text-brand-900">
                            {pick(locale, p.title)}
                          </a>
                        </li>
                      ) : null;
                    })}
                  </ul>
                )}

                {area.publications.length > 0 && (
                  <h3 class="mt-4 text-xs font-semibold uppercase tracking-wide text-cogito-400">
                    {t('common.relatedPublications')}
                  </h3>
                  <ul class="mt-1 space-y-1">
                    {area.publications.map((pubid) => {
                      const pub = getPublication(pubid);
                      return pub ? (
                        <li>
                          <a href="#publications" class="text-sm text-brand-700 underline hover:text-brand-900">
                            {pub.title}
                          </a>
                        </li>
                      ) : null;
                    })}
                  </ul>
                )}
              </div>
            </details>
          </li>
        ))
      }
      </ul>
      <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label={t('carousel.next')}>&#8250;</button>
    </div>
  </div>
</section>

<script>
  import '../../scripts/card-carousel.ts';
</script>
