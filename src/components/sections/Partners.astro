---
import { getLocale, useTranslations } from '../../utils/i18n';
import FilterBar from '../common/FilterBar.astro';
import { pick } from '../../data/types';
import { partners, partnerTypes } from '../../data/partners';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="reveal mx-auto max-w-6xl px-4 py-10">
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-white">{t('partners.title')}</h1>
    <p class="mt-2 text-brand-100">{t('partners.subtitle')}</p>
  </header>

  <div data-filter-root>
    <FilterBar>
    <div class="mb-6 flex flex-wrap items-center gap-2">
      <span class="text-sm font-semibold text-brand-100">{t('partners.filter.type')}:</span>
      <button type="button" class="filter-pill" data-filter-group="type" data-filter-value="" aria-pressed="true">{t('common.all')}</button>
      {
        partnerTypes.map((tp) => (
          <button type="button" class="filter-pill" data-filter-group="type" data-filter-value={tp} aria-pressed="false">{t(`partners.type.${tp}`)}</button>
        ))
      }
    </div>
    </FilterBar>

    <p class="mb-4 text-sm text-brand-200" data-filter-empty hidden>{t('common.empty')}</p>

    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        partners.map((p) => (
          <li class="card-3d" data-filter-item data-filter-type={p.type}>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="flex h-full flex-col items-center text-center">
              <span class="grid h-16 w-16 place-items-center rounded-2xl bg-cogito-100 text-xl font-bold text-cogito-500" aria-hidden="true">
                {p.name.charAt(0)}
              </span>
              <h2 class="mt-3 text-lg font-semibold text-cogito-800">{p.name}</h2>
              <span class="text-xs font-medium text-brand-700">{t(`partners.type.${p.type}`)}</span>
              {p.description && <p class="mt-2 text-sm text-cogito-500">{pick(locale, p.description)}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import '../../scripts/list-filter.ts';
</script>
