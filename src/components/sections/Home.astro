---
import { getLocale, useTranslations, navItems, localeUrl } from '../../utils/i18n';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Seções em destaque na home (subconjunto da navegação).
const featured = navItems.filter((i) =>
  ['nav.areas', 'nav.members', 'nav.projects', 'nav.news'].includes(i.key)
);
---

<section class="mx-auto max-w-6xl px-4 py-16 text-center">
  <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">
    {t('home.hero.eyebrow')}
  </p>
  <h1 class="mt-3 text-5xl font-extrabold tracking-tight text-cogito-900 sm:text-6xl">
    {t('home.hero.title')}
  </h1>
  <blockquote class="mt-6 text-xl italic text-cogito-600">
    {t('home.hero.quote')}
  </blockquote>
  <p class="mx-auto mt-3 max-w-2xl text-cogito-500">{t('home.hero.quoteContext')}</p>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-cogito-700">{t('home.hero.description')}</p>
</section>

<section class="mx-auto grid max-w-6xl gap-6 px-4 pb-12 sm:grid-cols-2">
  <div class="rounded-2xl border border-cogito-100 bg-cogito-50 p-6">
    <h2 class="text-lg font-semibold text-cogito-800">{t('home.hero.mission')}</h2>
    <p class="mt-2 text-cogito-600">{t('home.hero.missionText')}</p>
  </div>
  <div class="rounded-2xl border border-cogito-100 bg-cogito-50 p-6">
    <h2 class="text-lg font-semibold text-cogito-800">{t('home.hero.institutions')}</h2>
    <p class="mt-2 text-cogito-600">{t('home.hero.institutionsText')}</p>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-12">
  <h2 class="mb-6 text-2xl font-bold text-cogito-900">{t('home.sections.title')}</h2>
  <p class="mb-6 text-cogito-500">{t('home.sections.subtitle')}</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      featured.map((item) => (
        <a
          href={localeUrl(locale, item.href)}
          class="rounded-2xl border border-cogito-100 p-5 text-lg font-medium text-cogito-700 transition hover:border-brand-500 hover:bg-brand-50 hover:text-brand-700"
        >
          {t(item.key)}
        </a>
      ))
    }
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 text-center">
  <div class="rounded-3xl bg-cogito-800 p-10 text-white">
    <h2 class="text-2xl font-bold">{t('home.cta.title')}</h2>
    <p class="mx-auto mt-2 max-w-xl text-cogito-200">{t('home.cta.text')}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href={localeUrl(locale, '/join')}
        class="rounded-full bg-brand-500 px-5 py-2.5 font-medium text-white transition hover:bg-brand-400"
      >
        {t('nav.join')}
      </a>
      <a
        href={localeUrl(locale, '/contact')}
        class="rounded-full border border-cogito-600 px-5 py-2.5 font-medium text-cogito-100 transition hover:border-cogito-400"
      >
        {t('nav.contact')}
      </a>
    </div>
  </div>
</section>
