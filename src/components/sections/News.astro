---
import { getLocale, useTranslations, localeUrl } from '../../utils/i18n';
import FilterBar from '../common/FilterBar.astro';
import { pick } from '../../data/types';
import { newsCategories } from '../../data/news';
import { members } from '../../data/members';
import { getProject } from '../../data/projects';

interface Props {
  page: {
    data: any[];
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string; current: string };
  };
}

const { page } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const formatDate = (iso: string) => {
  const d = new Date(iso + 'T00:00:00');
  return d.toLocaleDateString(locale === 'pt-br' ? 'pt-BR' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
};
---

<section class="reveal mx-auto max-w-6xl px-4 py-10">
  <header class="mb-8">
    <h1 class="text-3xl font-bold text-white">{t('news.title')}</h1>
    <p class="mt-2 text-brand-100">{t('news.subtitle')}</p>
  </header>

  <div data-filter-root>
    <FilterBar>
    <div class="mb-6 flex flex-wrap items-center gap-2">
      <span class="text-sm font-semibold text-brand-100">{t('news.filter.category')}:</span>
      <button type="button" class="filter-pill" data-filter-group="category" data-filter-value="" aria-pressed="true">{t('common.all')}</button>
      {
        newsCategories.map((c) => (
          <button type="button" class="filter-pill" data-filter-group="category" data-filter-value={c} aria-pressed="false">{t(`news.cat.${c}`)}</button>
        ))
      }
    </div>
    </FilterBar>

    <p class="mb-4 text-sm text-brand-200" data-filter-empty hidden>{t('common.empty')}</p>

    <ul class="grid gap-6 sm:grid-cols-2">
      {
        page.data.map((item) => (
          <li class="card-3d" data-filter-item data-filter-category={item.category}>
            <article>
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">
                  {t(`news.cat.${item.category}`)}
                </span>
                <time datetime={item.date} class="text-xs text-cogito-400">{formatDate(item.date)}</time>
              </div>
              <h2 class="mt-2 text-lg font-semibold text-cogito-800">{pick(locale, item.title)}</h2>
              <p class="mt-1 text-sm text-cogito-600">{pick(locale, item.summary)}</p>

              {(item.members.length > 0 || item.projects.length > 0) && (
                <div class="mt-3 flex flex-wrap gap-3 text-xs text-cogito-400">
                  {item.members.length > 0 && (
                    <span>
                      {t('news.relatedMembers')}: {item.members.map((mid: string) => {
                        const member = members.find((m) => m.id === mid);
                        return member ? member.name : mid;
                      }).join(', ')}
                    </span>
                  )}
                  {item.projects.length > 0 && (
                    <span>
                      {t('news.relatedProjects')}: {item.projects.map((pid: string) => {
                        const pr = getProject(pid);
                        return pr ? pick(locale, pr.title) : pid;
                      }).join(', ')}
                    </span>
                  )}
                </div>
              )}

              <a href={localeUrl(locale, '/news')} class="mt-3 inline-block text-sm text-brand-700 underline hover:text-brand-900">
                {t('common.readMore')}
              </a>
            </article>
          </li>
        ))
      }
    </ul>

    {
      page.lastPage > 1 && (
        <nav class="mt-10 flex items-center justify-center gap-4" aria-label="Pagination">
          {page.url.prev ? (
            <a href={page.url.prev} class="btn-ghost px-4 py-2 text-sm">{'←'}</a>
           ) : (
             <span class="px-4 py-2 text-sm text-brand-200">←</span>
           )}
           <span class="text-sm text-brand-100">
             {page.currentPage} / {page.lastPage}
           </span>
           {page.url.next ? (
             <a href={page.url.next} class="btn-ghost px-4 py-2 text-sm">→</a>
           ) : (
             <span class="px-4 py-2 text-sm text-brand-200">→</span>
           )}
        </nav>
      )
    }
  </div>
</section>

<script>
  import '../../scripts/list-filter.ts';
</script>
