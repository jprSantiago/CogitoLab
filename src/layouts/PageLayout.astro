---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  /** Título exibido no topo da página (opcional). */
  heading?: string;
}

const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-10">
    {heading && <h1 class="mb-6 text-3xl font-bold text-cogito-900">{heading}</h1>}
    <slot />
  </div>
</BaseLayout>
