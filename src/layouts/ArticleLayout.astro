---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  /** Título do artigo. */
  articleTitle: string;
  /** Data de publicação (ISO) opcional. */
  date?: string;
  /** Autoria opcional. */
  author?: string;
}

const { title, description, articleTitle, date, author } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <header class="mb-8 border-b border-cogito-100 pb-6">
      <h1 class="text-3xl font-bold text-cogito-900">{articleTitle}</h1>
      {(date || author) && (
        <p class="mt-2 text-sm text-cogito-400">
          {date && <time datetime={date}>{date}</time>}
          {date && author && ' · '}
          {author && <span>{author}</span>}
        </p>
      )}
    </header>
    <div class="prose max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
