---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import IntroSplash from '../components/layout/IntroSplash.astro';
import { getLocale, useTranslations, stripLocale } from '../utils/i18n';
import { locales, defaultLocale } from '../i18n/config';
import { SITE_CONFIG } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  /** Nome da seção (ex.: "members") para derivar título/descrição de SEO do dicionário. */
  section?: string;
  intro?: boolean;
}

const { title, description, section, intro = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const pageTitle = title
  ? `${title} · ${t('site.title')}`
  : section
    ? `${t(`${section}.title`)} · ${t('site.title')}`
    : `${t('site.title')} — ${t('site.tagline')}`;

const pageDescription =
  description ?? (section ? t(`meta.${section}`) : '') ?? SITE_CONFIG.description;
const resolvedDescription = pageDescription || SITE_CONFIG.description;

const base = import.meta.env.BASE_URL;
let rawPath = Astro.url.pathname;
if (base !== '/' && rawPath.startsWith(base)) {
  rawPath = '/' + rawPath.slice(base.length);
}
const pathWithoutLocale = stripLocale(rawPath);
const buildUrl = (l: string) => {
  const rest = pathWithoutLocale === '/' ? '' : pathWithoutLocale;
  const url = `${SITE_CONFIG.url}/${l}${rest}`;
  return url.endsWith('/') ? url : `${url}/`;
};

const canonical = buildUrl(locale);
const ogImage = `${SITE_CONFIG.url}/og-image.svg`;
const siteUrl = `${SITE_CONFIG.url}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ResearchOrganization',
      '@id': `${siteUrl}#organization`,
      name: SITE_CONFIG.name,
      url: siteUrl,
      logo: `${SITE_CONFIG.url}/favicon.svg`,
      description: SITE_CONFIG.description,
      sameAs: [SITE_CONFIG.social.github],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: SITE_CONFIG.name,
      inLanguage: locale,
      publisher: { '@id': `${siteUrl}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <!-- Tema: aplica antes da pintura para evitar flash (light/dark) -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('cogito-theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:locale" content={locale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t('site.title')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Hreflang (SEO i18n) -->
    {locales.map((l) => <link rel="alternate" hreflang={l} href={buildUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={buildUrl(defaultLocale)} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="flex min-h-screen flex-col">
    {intro && <IntroSplash />}
    <div class="page-bg" aria-hidden="true"></div>
    <Navbar currentLocale={locale} pathname={Astro.url.pathname} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer currentLocale={locale} />

    <button
      id="back-to-top"
      type="button"
      class="btn-primary fixed bottom-5 right-5 z-50 hidden"
      aria-label={t('common.backToTop')}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>
  </body>
</html>

<script>
  const root = document.documentElement;
  function onScroll() {
    root.dataset.scrolled = window.scrollY > 24 ? 'true' : 'false';
  }
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  </script>

  <script>
    const btt = document.getElementById('back-to-top');
    if (btt) {
      window.addEventListener(
        'scroll',
        () => btt.classList.toggle('hidden', window.scrollY < 400),
        { passive: true }
      );
      btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }
  </script>
